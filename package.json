{
  "name": "next-ai-chat",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "vinext lint",
    "format": "prettier --write app/api/chat/route.ts app/chat.tsx lib/chat-request-schema.ts lib/chat-session.ts lib/chat-graph.ts test/chat-memory.spec.ts test/chat-request.spec.ts README.md package.json",
    "format:check": "prettier --check app/api/chat/route.ts app/chat.tsx lib/chat-request-schema.ts lib/chat-session.ts lib/chat-graph.ts test/chat-memory.spec.ts test/chat-request.spec.ts README.md package.json",
    "docs:check": "node scripts/check-jsdoc.mjs",
    "test": "vitest run",
    "loop:init": "node .agents/skills/loop-engineering/improvement-loop/cli.mjs init",
    "loop:record": "node .agents/skills/loop-engineering/improvement-loop/cli.mjs record",
    "loop:verify": "node .agents/skills/loop-engineering/improvement-loop/cli.mjs verify",
    "loop:promote": "node .agents/skills/loop-engineering/improvement-loop/cli.mjs promote",
    "loop:status": "node .agents/skills/loop-engineering/improvement-loop/cli.mjs status",
    "cf:dev": "vinext dev",
    "cf:build": "vinext build",
    "cf:deploy": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.14",
    "@langchain/openai": "^1.5.11",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-server-dom-webpack": "^19.2.8",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.54.6",
    "@cloudflare/workers-types": "^5.20260908.1",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vinext/cloudflare": "^1.0.0-beta.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.34",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.4",
    "prettier": "^3.9.6",
    "typescript": "^5.8.0",
    "vinext": "^1.0.0-beta.9",
    "vite": "^8.0.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^3.0.0",
    "wrangler": "^4.130.0"
  }
}
